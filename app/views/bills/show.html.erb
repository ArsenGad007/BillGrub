<%# Подписка на поток лайков: любые закладки этого законопроекта обновляют
    счётчик на странице через websocket (Action Cable + Turbo Streams). %>
<%= turbo_stream_from @bill, :likes %>

<article class="bill-detail">
  <header class="bill-detail__head">
    <div>
      <h1><%= @bill.title %></h1>
      <p class="number">
        <%= @bill.number %>
        <span class="status"><%= @bill.status_label %></span>
      </p>
    </div>

    <div class="bill-actions">
      <%= render "bills/likes", bill: @bill %>
      <%= render "bills/like_button", bill: @bill %>
    </div>
  </header>

  <section class="bill-meta">
    <h2>Данные из Госдумы</h2>
    <dl class="meta-grid">
      <% if @bill.registered_on %>
        <div><dt>Внесён</dt><dd><%= @bill.registered_on.strftime("%d.%m.%Y") %></dd></div>
      <% end %>
      <div><dt>Стадия</dt>
        <dd>
          <% if @bill.stage_label.present? %>
            <%= @bill.stage_label %>
            <% if @bill.stage_on %>— <%= @bill.stage_on.strftime("%d.%m.%Y") %><% end %>
            <% if @bill.stage_result.present? %> (<%= @bill.stage_result %>)<% end %>
          <% else %>
            не получена
          <% end %>
        </dd>
      </div>
      <% if @bill.law_number.present? %>
        <div><dt>Номер закона</dt><dd><%= @bill.law_number %></dd></div>
      <% end %>
      <div><dt>Официальная карточка</dt>
        <dd>
          <% if @bill.source_url.present? %>
            <%= link_to "sozd.duma.gov.ru", @bill.source_url, target: "_blank", rel: "noopener" %>
          <% else %>
            —
          <% end %>
        </dd>
      </div>
    </dl>
  </section>

  <section class="bill-text">
    <h2>Полный текст</h2>
    <% if @bill.full_text.present? %>
      <details <%= "open" if @bill.original_text.blank? %>>
        <summary>Показать полный текст документа (<%= @bill.full_text.length %> знаков)</summary>
        <pre class="bill-full-text"><%= @bill.full_text %></pre>
      </details>
    <% elsif @bill.document_url.present? %>
      <p>
        Текст в формате, который можно прочитать на сайте, не получен.
        <%= link_to "Скачать официальный документ", @bill.document_url, target: "_blank", rel: "noopener" %>.
      </p>
    <% elsif @bill.original_text.present? %>
      <p><%= @bill.original_text %></p>
    <% else %>
      <p class="empty">Полный текст пока не загружен. Нажмите «Загрузить из Госдумы» на главной странице.</p>
    <% end %>
    <% if @bill.document_url.present? %>
      <p class="hint">Официальный документ: <%= link_to @bill.document_url, @bill.document_url, target: "_blank", rel: "noopener" %></p>
    <% end %>
  </section>

  <section class="bill-text simplified">
    <h2>Упрощённо</h2>
    <% if @bill.simplified? %>
      <p><%= @bill.latest_simplification.content %></p>
      <p class="hint">Модель: <%= @bill.latest_simplification.model_name_used %></p>
    <% else %>
      <p class="empty">Пока нет упрощённой версии.</p>
    <% end %>
  </section>

  <% if @bill.original_text.present? && user_signed_in? %>
    <div class="bill-actions">
      <%= button_to(@bill.simplified? ? "Упростить заново" : "Упростить нейросетью",
            bill_simplification_path(@bill),
            method: :post,
            class: "btn btn--primary") %>
    </div>
  <% end %>

  <% if @bill.source_url.present? %>
    <p class="hint">Источник: <%= @bill.source_url %></p>
  <% end %>

  <p class="back-link"><%= link_to "← Ко всем законопроектам", root_path %></p>
</article>
