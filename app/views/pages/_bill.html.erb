<article class="bill">
  <%# Карточка подписана на поток лайков: счётчик обновляется без перезагрузки. %>
  <%= turbo_stream_from bill, :likes %>

  <header>
    <h2><%= link_to bill.title, bill_path(bill) %></h2>
    <span class="status"><%= bill.status_label %></span>
  </header>
  <p class="number">
    <%= bill.number %>
    <%= render "bills/likes", bill: bill %>
  </p>
  <p class="meta">
    <% if bill.registered_on %>
      <span>Внесён <%= bill.registered_on.strftime("%d.%m.%Y") %></span>
    <% end %>
    <% if bill.stage_label.present? %>
      <span class="stage"><%= bill.stage_label %></span>
      <% if bill.stage_on %><time><%= bill.stage_on.strftime("%d.%m.%Y") %></time><% end %>
    <% end %>
  </p>
  <p><%= bill.display_text %></p>
</article>
